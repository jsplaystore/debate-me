# ── Inference provider ──────────────────────────────────────────────────────
# The app auto-selects the provider: Groq if GROQ_API_KEY is set, else Hugging
# Face. Both use open-source models (Llama-3.x, Mixtral, etc.). Groq is
# recommended — it's free, extremely fast, and has generous limits.

# Groq (recommended) — free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ── Hugging Face (optional) ─────────────────────────────────────────────────
# Used if GROQ_API_KEY is absent, or set LLM_PROVIDER=hf to force it.
# Free token (Read scope) at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_CHAT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_CLASSIFIER_MODEL=facebook/bart-large-mnli

# Optional: force a provider ("groq" or "hf"). Omit to auto-select.
# LLM_PROVIDER=groq
