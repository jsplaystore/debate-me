# Hugging Face access token (free) — https://huggingface.co/settings/tokens
# Create a token with "Read" access. Free tier is enough for this app.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides. Defaults are chosen to work on the free serverless tier.
# Generative debate model (chat completion capable):
HF_CHAT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Zero-shot classifier for argument-strength scoring:
HF_CLASSIFIER_MODEL=facebook/bart-large-mnli
